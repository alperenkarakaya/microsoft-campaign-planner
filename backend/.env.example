# Copy to backend/.env and fill in real values. Never commit the populated file.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/influencer_roi_db

# --- Redis (cache for YouTube API responses) ---
REDIS_URL=redis://localhost:6379

# --- External APIs ---
YOUTUBE_API_KEY=
GEMINI_API_KEY=

# --- Auth (JWT) ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Runtime ---
# "production" makes a weak/missing JWT_SECRET_KEY fatal and disables auto table creation.
ENVIRONMENT=development
LOG_LEVEL=INFO
